# ── Libraries ────────────────────────────────────────────────────────────────
# One entry per Kavita library: LIBRARY_<NAME>=<absolute path to library root>
# The <NAME> part becomes the label shown in the web UI (underscores -> spaces).
# These must be the same root folders your Kavita libraries point to.
LIBRARY_COMICS=/path/to/kavita/comics
LIBRARY_MANGA=/path/to/kavita/manga

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=false
SECRET_KEY=replace-with-a-random-string

# ── Uploads ──────────────────────────────────────────────────────────────────
# Max size per request in MB, and accepted file extensions (comma-separated).
MAX_UPLOAD_MB=1024
ALLOWED_EXTENSIONS=cbz,cbr,cb7,cbt,zip,rar,7z,pdf,epub

# ── Kavita API (optional) ────────────────────────────────────────────────────
# If both are set, a "scan all libraries" is triggered after each upload so new
# files show up in Kavita right away. Get the API key from your Kavita user:
# Settings -> Account -> API Key.
#KAVITA_URL=http://localhost:5001
#KAVITA_API_KEY=your-kavita-api-key
