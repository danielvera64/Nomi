# ── Libraries ────────────────────────────────────────────────────────────────
# One entry per Kavita library: LIBRARY_<NAME>=<absolute path to library root>
# The <NAME> part becomes the label shown in the web UI (underscores -> spaces).
# These must be the same root folders your Kavita libraries point to.
LIBRARY_COMICS=/path/to/kavita/comics
LIBRARY_MANGA=/path/to/kavita/manga
LIBRARY_BOOKS=/path/to/kavita/books

# ── Other self-hosted apps ───────────────────────────────────────────────────
# One entry per app: APP_<NAME>=<url>. Each becomes a button on Nomi's home
# page that opens in a new tab. The <NAME> part is the label shown
# (underscores -> spaces). Use an address reachable from the device you browse
# from — a phone cannot open "localhost".
APP_KAVITA=http://localhost:5001
APP_IMMICH=http://localhost:2283

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=false
SECRET_KEY=replace-with-a-random-string

# ── Uploads ──────────────────────────────────────────────────────────────────
# Max size per request in MB, and accepted file extensions (comma-separated).
MAX_UPLOAD_MB=1024
ALLOWED_EXTENSIONS=cbz,cbr,cb7,cbt,zip,rar,7z,pdf,epub

# ── Kavita API (optional) ────────────────────────────────────────────────────
# If both are set, a "scan all libraries" is triggered after each upload so new
# files show up in Kavita right away. Get the API key from your Kavita user:
# Settings -> Account -> API Key.
#KAVITA_URL=http://localhost:5001
#KAVITA_API_KEY=your-kavita-api-key

# ── ComfyUI (media content generator) ──────────────────────────────────────
# Base URL of a running ComfyUI server (use an address reachable from the
# device you browse from — a phone cannot open "localhost").
#COMFYUI_URL=http://localhost:8188
# Optional: path to a different ComfyUI API workflow JSON (defaults to the
# bundled workflows/ZImageTurbo-Workflow-API.json).
#COMFYUI_WORKFLOW=/path/to/workflow.json
# Where the ComfyUI server saves generated images (for the download button).
#COMFYUI_OUTPUT_DIR=~/ComfyUI/output

# ── NVIDIA NIM (for image-to-prompt) ───────────────────────────────────────
# NVIDIA API key for accessing NIM models.
#NVIDIA_API_KEY=your-nvidia-api-key
# Vision model to use for generating prompts from images.
#NIM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
